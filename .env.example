# Copy to .env.local for `npm run dev`. Names only; never commit real values.
# With none of these set, `npm run dev` uses a local database file and a
# synthetic sign-in (Seedy, the local pilot owner), so nothing is required.

# Synthetic development identity; the local sign-in uses this exact address.
POLIS_OWNER_EMAIL=seedy@sites.test
# Shown on /privacy as the contact for data requests.
NEXT_PUBLIC_POLIS_CONTACT_EMAIL=

# Production (set in Vercel, not here):
#   TURSO_DATABASE_URL, TURSO_AUTH_TOKEN         community database
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY   sign-in
#   POLIS_OWNER_EMAIL                            the organizer's verified email
#   NEXT_PUBLIC_POLIS_CONTACT_EMAIL              privacy contact
# To try Clerk locally, add its development keys to .env.local.
